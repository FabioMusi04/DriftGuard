{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriftGuard CLI structured JSON error v1",
  "type": "object",
  "required": ["kind", "tool", "version", "schemaVersion", "error", "exitCode"],
  "properties": {
    "kind": {"const": "error"},
    "tool": {"const": "DriftGuard"},
    "version": {"type": "string"},
    "schemaVersion": {"const": 1},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["invalid-input", "io-error", "access-denied", "usage-error", "internal-error"]},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    },
    "exitCode": {"const": 2}
  },
  "additionalProperties": false
}
