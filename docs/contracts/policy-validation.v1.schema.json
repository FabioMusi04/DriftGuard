{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriftGuard CLI policy validation v1",
  "type": "object",
  "required": ["kind", "tool", "version", "schemaVersion", "valid", "policyVersion", "ruleCount", "severityCounts"],
  "properties": {
    "kind": {"const": "policy-validation"},
    "tool": {"const": "DriftGuard"},
    "version": {"type": "string"},
    "schemaVersion": {"const": 1},
    "valid": {"const": true},
    "policyVersion": {"const": 1},
    "ruleCount": {"type": "integer", "minimum": 1},
    "severityCounts": {
      "type": "object",
      "required": ["info", "warning", "error"],
      "properties": {
        "info": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
